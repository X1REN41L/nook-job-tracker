generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id          String             @id @default(cuid())
  company     String
  role        String
  status      Status             @default(APPLIED)
  archived    Boolean            @default(false)
  revision    Int                @default(0)
  source      String?
  appliedDate DateTime
  // Set when the "add an interview" prompt is skipped; cleared when the application leaves Interview.
  interviewDatePromptDismissed Boolean @default(false)
  followUpDate DateTime?
  // Why the follow-up was set; cleared with the follow-up date.
  followUpNote String?
  lastUpdated DateTime           @updatedAt
  notes       String?
  jobUrl      String?
  events      ApplicationEvent[]
  interviews  Interview[]
  contacts    Contact[]
  createdAt   DateTime           @default(now())

  @@index([status])
  @@index([appliedDate])
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          EventType
  fromStatus    Status?
  toStatus      Status?
  detail        String?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

// One interview round. `date` is a calendar date stored at UTC midnight; `time` is an optional local "HH:MM".
model Interview {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  date          DateTime
  time          String?
  type          InterviewType @default(OTHER)
  interviewers  String?
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([applicationId])
  @@index([date])
}

model Contact {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  role          String?
  email         String?
  linkedinUrl   String?
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model UndoSnapshot {
  token String @id
  applicationId String
  payload String
  expiresAt DateTime

  @@index([expiresAt])
}

model Settings {
  id Int @id @default(1)
  value String
  revision Int @default(0)
}

enum Status {
  APPLIED
  ONLINE_ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
}

enum InterviewType {
  PHONE
  TECHNICAL
  ONSITE
  OTHER
}

enum EventType {
  STATUS_CHANGE
  NOTE_ADDED
  // Detail: the follow-up date ("YYYY-MM-DD"), then a space and its note when it has one.
  FOLLOW_UP_SET
  // Detail: the date of the follow-up that was marked done or cleared.
  FOLLOW_UP_DONE
}
