yarn-error.log*
*.log

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma: the schema is applied with `prisma db push`; migrations are not used
prisma/migrations/
*.db
*.db-journal
*.db-wal
*.db-shm
# setup state for an unfinished legacy conversion: saved interview dates and the rollback-copy record
prisma/interview-dates-to-copy.json
prisma/setup-rollback.json

# editor swap / IDE files
*.swp
*.swn
*.swo
*~
.vscode/
.idea/

# local audit and agent files
/audit/
/STATUS.md
/AGENTS.md
/CLAUDE.md
# supported browser tests; other test files stay local
/tests/*
!/tests/e2e/
/tests/e2e/*
!/tests/e2e/*.spec.ts
!/tests/e2e/api-helpers.ts
# supported test runners and test cases; sample-data.mjs stays local
/scripts/*
!/scripts/setup.mjs
!/scripts/*-test.mjs
!/scripts/unit-loader.mjs
!/scripts/unit-loader-register.mjs
!/scripts/run-backup-api-test.sh
!/scripts/run-playwright.sh
