{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-playwright.0tzClf/types/**/*.ts",
    ".next-playwright.0tzClf/dev/types/**/*.ts",
    ".next-playwright.GfHVd7/types/**/*.ts",
    ".next-playwright.GfHVd7/dev/types/**/*.ts",
    ".next-playwright.vw7hav/types/**/*.ts",
    ".next-playwright.vw7hav/dev/types/**/*.ts",
    ".next-playwright.HsWEek/types/**/*.ts",
    ".next-playwright.HsWEek/dev/types/**/*.ts",
    ".next-playwright.70jFid/types/**/*.ts",
    ".next-playwright.70jFid/dev/types/**/*.ts",
    ".next-playwright.6livTq/types/**/*.ts",
    ".next-playwright.6livTq/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
